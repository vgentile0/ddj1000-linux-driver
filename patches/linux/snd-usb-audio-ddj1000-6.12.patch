  * This function is called from the context of an endpoint that received
  * the packet and is used to let another endpoint object handle the payload.
  */
+/* Pioneer DDJ-1000: pace playback nominally on empty implicit-fb URBs */
+static inline bool ddj1000_nominal_fb(struct snd_usb_endpoint *ep)
+{
+	return ep->chip->usb_id == USB_ID(0x2b73, 0x0020);
+}
+
 static void snd_usb_handle_sync_urb(struct snd_usb_endpoint *ep,
 				    struct snd_usb_endpoint *sender,
 				    const struct urb *urb)
@@ -1811,8 +1817,13 @@
 		/*
 		 * skip empty packets. At least M-Audio's Fast Track Ultra stops
 		 * streaming once it received a 0-byte OUT URB
+		 *
+		 * The Pioneer DDJ-1000 never sends payload on its implicit
+		 * feedback endpoint under Linux, so skipping would stall
+		 * playback forever. For that device only, keep the sink
+		 * moving with nominal pacing instead (see below).
 		 */
-		if (bytes == 0)
+		if (bytes == 0 && !ddj1000_nominal_fb(ep))
 			return;
 
 		spin_lock_irqsave(&ep->lock, flags);
@@ -1838,6 +1849,23 @@
 		 */
 
 		out_packet->packets = in_ctx->packets;
+
+		/*
+		 * DDJ-1000: empty implicit-fb URB. A zero packet_size[] makes
+		 * snd_usb_endpoint_next_packet_size() fall back to the nominal
+		 * rate (freqm), so no 0-byte OUT URB is ever sent.
+		 */
+		if (bytes == 0) {
+			for (i = 0; i < in_ctx->packets; i++)
+				out_packet->packet_size[i] = 0;
+			spin_unlock_irqrestore(&ep->lock, flags);
+			usb_audio_dbg(ep->chip,
+				      "empty implicit fb URB on EP 0x%x, nominal pacing\n",
+				      sender->ep_num);
+			snd_usb_queue_pending_output_urbs(ep, false);
+			return;
+		}
